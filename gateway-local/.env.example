# npm start creates .env with random values for these credentials.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
POSTGRES_PASSWORD=

# Default Bedrock Region. Individual models can override this in config.yaml.
AWS_REGION=eu-west-1

# Uses ~/.aws read-only. Uncomment to select a named profile or another directory.
# AWS_PROFILE=my-profile
# AWS_CONFIG_DIR=/path/to/.aws

# Change the local port if 4000 is already in use.
LOCAL_PORT=4000
