{
  "name": "llm-gateway-cdk",
  "version": "0.1.0",
  "scripts": {
    "bootstrap": "cdk bootstrap --context includePublicAccess=true",
    "build": "tsc",
    "lint": "oxlint bin lib --deny-warnings",
    "synth": "cdk synth \"*\"",
    "deploy": "cdk deploy --all --require-approval never",
    "destroy": "cdk destroy --all --force --context includePublicAccess=true"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "26.6.5",
    "aws-cdk": "2.1145.0",
    "esbuild": "0.28.2",
    "oxlint": "1.88.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "3.1152.0",
    "aws-cdk-lib": "2.273.0",
    "aws-jwt-verify": "5.2.1",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1",
    "zod": "4.6.7"
  }
}
